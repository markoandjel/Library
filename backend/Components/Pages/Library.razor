        public int? PublisherId { get; set; }
        public int? Year { get; set; }
        public int? PageCount { get; set; }
        public int? VolumeCount { get; set; }
        public int? Width { get; set; }
        public int? Height { get; set; }
        public int? Thickness { get; set; }
        public string Isbn { get; set; } = "";
        public string BookNote { get; set; } = "";
        public bool Prevod { get; set; }
        public bool DomaciAutor { get; set; }
        public bool StraniAutor { get; set; }
        public bool TvrdiPovez { get; set; }
    }
    private enum MediaTab
    {
        Image,
        Shelf
    }

    private sealed record BookView(
        int Id,
        int? InventoryId,
        string Title,
        string Author,
        string TitleNote,
        int? PublisherId,
        string Publisher,
        int? LanguageId,
        int? ScriptId,
        int? OriginalLanguageId,
        object? Year,
        object? PageCount,
        object? VolumeCount,
        object? Width,
        object? Height,
        object? Thickness,
        string Language,
        string Script,
        string OriginalLanguage,
        string Isbn,
        string BookNote,
        bool? Prevod,
        bool? DomaciAutor,
        bool? StraniAutor,
        bool? TvrdiPovez,
        int? ShelfId,
        int? ShelfX,
        int? ShelfY,
        int? CabinetId,
        string CabinetName)
    {
        public string ImageUrl => $"/book-cover/{InventoryId ?? Id}";
        public string CabinetImageUrl => CabinetId is null ? "" : $"/cabinet-image/{CabinetId}";

        public static BookView From(Dictionary<string, object?> row) => new(
            ToInt(row["id"]),
            row["knjiga_id"] is null ? null : ToInt(row["knjiga_id"]),
            ToStringValue(row["naslov"]),
            ToStringValue(row["autor"]),
            ToStringValue(row["primedba_naslov"]),
            row["izdavac_id"] is null ? null : ToInt(row["izdavac_id"]),
            ToStringValue(row["izdavac"]),
            row["jezik_id"] is null ? null : ToInt(row["jezik_id"]),
            row["pismo_id"] is null ? null : ToInt(row["pismo_id"]),
            row["originalni_jezik_id"] is null ? null : ToInt(row["originalni_jezik_id"]),
            row["godina"],
            row["broj_strana"],
            row["broj_tomova"],
            row["sirina"],
            row["visina"],
            row["debljina"],
            ToStringValue(row["jezik"]),
            ToStringValue(row["pismo"]),
            ToStringValue(row["originalni_jezik"]),
            ToStringValue(row["isbn"]),
            ToStringValue(row["primedba_knjiga"]),
            ToBool(row["prevod"]),
            ToBool(row["domaci_autor"]),
            ToBool(row["strani_autor"]),
            ToBool(row["tvrdi_povez"]),
            row["shelf_id"] is null ? null : ToInt(row["shelf_id"]),
            row["shelf_x"] is null ? null : ToInt(row["shelf_x"]),
            row["shelf_y"] is null ? null : ToInt(row["shelf_y"]),
            row["cabinet_id"] is null ? null : ToInt(row["cabinet_id"]),
            ToStringValue(row["cabinet_name"]));
    }
