@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.Globalization
@using System.Security.Cryptography
@implements IDisposable
@page "/uvoz-knjiga"
@inject AccessImportService AccessImport
@inject Db Db
@inject SftpImageService Images
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.False" Class="import-shell">
    <div class="import-header">
        <div>
            <MudText Typo="Typo.h4" Class="import-title">Uvoz knjiga</MudText>
            <MudText Class="import-subtitle">Priprema uvoza knjiga iz Microsoft Access baze.</MudText>
        </div>
    </div>

    <div class="import-layout">
        <MudPaper Class="import-card" Elevation="1">
            <MudText Typo="Typo.h6" Class="import-card-title">Access fajl</MudText>

            <label class="import-upload-box">
                <span class="import-upload-icon">
                    <MudIcon Icon="@Icons.Material.Filled.UploadFile" />
                </span>
                <span class="import-upload-text">Izaberite .accdb ili .mdb fajl</span>
                <span class="import-upload-name">@SelectedFileName</span>
                <input @ref="_accessFileInput" type="file" class="import-file-input" @onchange="SelectAccessFile" accept=".accdb,.mdb" disabled="@_isLoading" />
            </label>

            <div class="import-actions">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="import-action-button" StartIcon="@Icons.Material.Filled.RestartAlt" Disabled="@(!_hasFile || _isLoading)" OnClick="ClearFile">
                    Ponisti
                </MudButton>
            </div>

            <div class="import-status">
                <MudText Class="import-status-label">Status</MudText>
                <MudText Class="import-status-value">@StatusText</MudText>
                @if (_isLoading)
                {
                    <div class="access-upload-progress-wrap">
                        <progress id="access-upload-progress" class="access-upload-progress" max="100" value="0"></progress>
                        <span id="access-upload-progress-text" class="import-status-value">Priprema uploada...</span>
                    </div>
                }
            </div>
        </MudPaper>

        <MudPaper Class="import-table-card" Elevation="1">
            <div class="import-table-header">
                <div>
                    <MudText Typo="Typo.h5" Class="import-table-title">Knjige za uvoz</MudText>
                    <MudText Class="import-subtitle">Prvih 100 knjiga iz Access fajla koje ne postoje u bazi po kljucu knjiga_id.</MudText>
                </div>
                                <div class="import-count-actions">
                    <span class="import-count-badge">BROJ KNJIGA: @_books.Count</span>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" Class="import-add-all-button" StartIcon="@Icons.Material.Filled.PlaylistAdd" Disabled="@(_books.Count == 0 || _isLoading || _savingBookId is not null || _bulkImporting)" OnClick="AddAllBooksToDatabase">
                        @if (_bulkImporting)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="import-button-spinner" />
                        }
                        else
                        {
                            <span>Dodaj sve</span>
                        }
                    </MudButton>
                </div>
            </div>

            <div class="import-table-wrap">
                <table class="import-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Naslov knjige</th>
                            <th>Autori</th>
                            <th>Akcija</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!string.IsNullOrWhiteSpace(_errorMessage))
                        {
                            <tr>
                                <td colspan="4" class="import-empty-row">@_errorMessage</td>
                            </tr>
                        }
                        else if (_books.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="import-empty-row">Izaberite Access fajl za uvoz u container.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var book in PagedBooks)
                            {
                                var isSaving = _savingBookId == book.Id;
                                <tr class="import-book-row"
                                    @onmouseenter="args => ShowCover(book, args)"
                                    @onmousemove="MoveCover"
                                    @onmouseleave="HideCover">
                                    <td>@book.Id</td>
                                    <td>@book.Title</td>
                                    <td>@book.Authors</td>
                                    <td class="import-action-cell">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" Class="import-add-button" StartIcon="@Icons.Material.Filled.Add" Disabled="@(isSaving || _savingBookId is not null || _bulkImporting)" OnClick="() => AddBookToDatabase(book)">
                                            @if (isSaving)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="import-button-spinner" />
                                            }
                                            else
                                            {
                                                <span>Dodaj</span>
                                            }
                                        </MudButton>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (_books.Count > PageSize)
            {
                <div class="police-pager import-pager" tabindex="0" @onkeydown="HandlePagerKeyDown">
                    <button type="button" disabled="@(_pageIndex == 0)" @onclick="PreviousPage" title="Prethodna strana">
                        <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" />
                    </button>
                    <span>@(_pageIndex + 1) / @TotalPages</span>
                    <button type="button" disabled="@(_pageIndex >= TotalPages - 1)" @onclick="NextPage" title="Sledeca strana">
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
                    </button>
                </div>
            }
        </MudPaper>
    </div>

    @if (_hoveredBook is not null)
    {
        <div class="@CoverPreviewClass" style="@CoverPreviewStyle">
            <img src="@CoverUrl(_hoveredBook)" alt="Korice @_hoveredBook.Title" />
            <div class="import-cover-title">@_hoveredBook.Title</div>
        </div>
    }
</MudContainer>

@code {
    private const int PageSize = 10;
    private const int PreviewCount = 100;
    private const string Letters = "abcdefghijklmnopqrstuvwxyz";

    private ElementReference _accessFileInput;
    private string? _fileName;
    private string? _activeAccessPath;
    private string? _uploadedTempPath;
    private string? _uploadId;
    private bool _hasFile;
    private bool _isLoading;
    private int? _savingBookId;
    private bool _bulkImporting;
    private int _bulkDone;
    private int _bulkTotal;
    private int _pageIndex;
    private string? _errorMessage;
    private List<AccessBookPreview> _books = [];
    private AccessBookPreview? _hoveredBook;
    private double _coverX;
    private double _coverY;
    private bool _coverOnLeft;

    private IEnumerable<AccessBookPreview> PagedBooks => _books.Skip(_pageIndex * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_books.Count / (double)PageSize));
    private string CoverPreviewClass => $"import-cover-popover {(_coverOnLeft ? "left" : "right")}";
    private string CoverPreviewStyle => string.Create(CultureInfo.InvariantCulture, $"left: {_coverX}px; top: {_coverY}px;");
    private string SelectedFileName => string.IsNullOrWhiteSpace(_fileName) ? "Nijedan fajl nije izabran" : _fileName;
    private string StatusText
    {
        get
        {
            if (_bulkImporting)
            {
                return $"Uvozim knjige: {_bulkDone}/{_bulkTotal}";
            }

            if (_savingBookId is not null)
            {
                return $"Snimam knjigu id: {_savingBookId.Value} u bazu i otpremam korice...";
            }


            if (_isLoading)
            {
                return "Citam Access fajl i proveravam knjiga_id u bazi...";
            }

            if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                return "Doslo je do greske pri citanju fajla.";
            }

            if (_books.Count > 0)
            {
                return $"Pronadjeno je {_books.Count} knjiga koje jos nisu u bazi.";
            }

            return "Izaberite Access fajl za upload u container.";
        }
    }

    private async Task SelectAccessFile()
    {
        var file = await JS.InvokeAsync<BrowserUploadFile?>("libraryAccessUpload.fileInfo", _accessFileInput);
        if (file is null)
        {
            return;
        }

        ClearStoredUpload();
        _fileName = file.Name;
        _hasFile = true;
        _isLoading = true;
        _pageIndex = 0;
        _errorMessage = null;
        _books = [];

        await InvokeAsync(StateHasChanged);
        var stage = "upload";
        try
        {
            var uploaded = await JS.InvokeAsync<CompletedBrowserUpload>(
                "libraryAccessUpload.upload", _accessFileInput);
            _uploadedTempPath = uploaded.Path;
            _uploadId = uploaded.Id;
            _activeAccessPath = uploaded.Path;
            stage = "preview";
            var existingIds = await LoadExistingBookIds();
            var books = await AccessImport.ReadPreviewFromPathAsync(uploaded.Path, existingIds, PreviewCount);
            _books = books.ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            await LogBrowserError(stage, ex, _fileName);
            ClearStoredUpload();
        }
        finally
        {
            _isLoading = false;
            }
    }


    private async Task AddAllBooksToDatabase()
    {
        if (_bulkImporting || _savingBookId is not null || _books.Count == 0)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_activeAccessPath))
        {
            Snackbar.Add("Prvo izaberite Access fajl.", Severity.Warning);
            return;
        }

        _bulkImporting = true;
        _bulkDone = 0;
        _bulkTotal = _books.Count;
        var processed = 0;
        var failed = 0;

        foreach (var book in _books.ToList())
        {
            var beforeCount = _books.Count;
            await AddSingleBookToDatabase(book);
            if (_books.Count < beforeCount)
            {
                processed++;
            }
            else
            {
                failed++;
            }

            _bulkDone++;
            await InvokeAsync(StateHasChanged);
        }

        var total = processed + failed;
        _bulkImporting = false;
        _savingBookId = null;
        _bulkDone = 0;
        _bulkTotal = 0;

        Snackbar.Configuration.VisibleStateDuration = 5000;
        var severity = failed == 0 ? Severity.Success : Severity.Warning;
        Snackbar.Add($"Uvoz zavrsen: {processed} od {total} knjiga obradjeno.", severity);
    }

    private Task AddBookToDatabase(AccessBookPreview preview) => AddSingleBookToDatabase(preview);
    private async Task AddSingleBookToDatabase(AccessBookPreview preview)
    {
        if (_savingBookId is not null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_activeAccessPath))
        {
            Snackbar.Add("Prvo izaberite Access fajl.", Severity.Warning);
            return;
        }

        _savingBookId = preview.Id;
        _hoveredBook = null;
        try
        {
            var duplicate = await Db.SingleAsync("SELECT id FROM knjiga WHERE knjiga_id = @knjiga_id", new { KnjigaId = preview.Id });
            if (duplicate is not null)
            {
                if (!_bulkImporting)
                {
                    Snackbar.Add($"Knjiga id: {preview.Id} vec postoji u bazi.", Severity.Warning);
                }
                RemovePreview(preview.Id);
                return;
            }

            var imported = await AccessImport.ReadBookImportAsync(_activeAccessPath, preview.Id);
            if (imported is null)
            {
                throw new InvalidOperationException("Knjiga nije pronadjena u Access fajlu.");
            }

            if (string.IsNullOrWhiteSpace(imported.Title))
            {
                throw new InvalidOperationException("Knjiga nema naslov u Access fajlu.");
            }

            if (imported.Cover is null)
            {
                throw new InvalidOperationException("Knjiga nema korice u Access fajlu.");
            }

            var imageFileName = await CreateUniqueBookImageNameAndUpload(imported.Cover);
            var publisherId = await EnsureNamedId("izdavac", "naziv", imported.Publisher);
            var authorIds = await EnsureNamedIds("autor", "ime", imported.Authors);
            var languageIds = await EnsureNamedIds("jezik", "naziv", imported.Languages);
            var originalLanguageIds = await EnsureNamedIds("jezik", "naziv", imported.OriginalLanguages);
            var scriptIds = await EnsureNamedIds("pismo", "naziv", imported.Scripts);
            var categoryIds = await EnsureCategoryIds(imported.Categories);

            var shelfId = await ExistingShelfIdOrNull(imported.ShelfId);
            var payload = new BookPayload
            {
                Naslov = imported.Title,
                PrimedbaNaslov = EmptyToNull(imported.TitleNote),
                IzdavacId = publisherId,
                Godina = imported.Year,
                BrojStrana = imported.PageCount,
                BrojTomova = imported.VolumeCount ?? 1,
                JezikId = FirstOrNull(languageIds),
                OriginalniJezikId = FirstOrNull(originalLanguageIds),
                PismoId = FirstOrNull(scriptIds),
                Prevod = imported.Prevod,
                Isbn = EmptyToNull(imported.Isbn),
                PrimedbaKnjiga = EmptyToNull(imported.Note),
                DomaciAutor = imported.DomaciAutor,
                StraniAutor = imported.StraniAutor,
                TvrdiPovez = imported.TvrdiPovez,
                Kolor = imported.Kolor,
                Fotokopija = imported.Fotokopija,
                Sirina = imported.Width,
                Visina = imported.Height,
                Debljina = imported.Thickness,
                BrojPrimeraka = imported.Copies ?? 1,
                Vreme = EmptyToNull(imported.Time) ?? DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture),
                SlikaNepotrebna = imported.SlikaNepotrebna,
                SlikaVelika = imported.SlikaVelika,
                SlikaUnutrasnja = imported.SlikaUnutrasnja,
                KnjigaId = imported.Id,
                PolicaId = shelfId,
                AutorIds = authorIds,
                KategorijaIds = categoryIds,
                JezikIds = languageIds,
                JezikOrigIds = originalLanguageIds,
                PismoIds = scriptIds
            };

            await Db.InsertAsync(Sql.BookInsert, payload.ToDbParams(imported.Id));
            await SyncImportRelations(imported.Id, payload);
            await Db.ExecuteAsync("INSERT INTO slika (naziv, knjiga_id) VALUES (@naziv, @knjiga_id)", new { Naziv = imageFileName, KnjigaId = imported.Id });

            RemovePreview(preview.Id);
            Snackbar.Configuration.VisibleStateDuration = 3000;
            Snackbar.Add($"Knjiga id: {preview.Id} uspesno sacuvana.", Severity.Success);
        }
        catch (Exception ex)
        {
            await LogBrowserError("save-book", ex, $"bookId={preview.Id}");
            Snackbar.Configuration.VisibleStateDuration = 5000;
            Snackbar.Add($"Knjiga id: {preview.Id} nije sacuvana: {ex.Message}", Severity.Error);
        }
        finally
        {
            _savingBookId = null;
        }
    }

    private async Task<string> CreateUniqueBookImageNameAndUpload(AccessImage image)
    {
        for (var attempt = 0; attempt < 100; attempt++)
        {
            var fileName = RandomLetters(5) + ExtensionFor(image.ContentType);
            var existsInDb = await Db.SingleAsync("SELECT id FROM slika WHERE naziv = @naziv", new { Naziv = fileName });
            if (existsInDb is not null || await Task.Run(() => Images.BookImageExists(fileName)))
            {
                continue;
            }

            if (await Task.Run(() => Images.TryUploadBookImage(image.Bytes, fileName)))
            {
                return fileName;
            }
        }

        throw new InvalidOperationException("Korice nisu mogle da se otpreme na SFTP sa jedinstvenim imenom.");
    }

    private static string RandomLetters(int length)
    {
        Span<char> chars = stackalloc char[length];
        for (var index = 0; index < length; index++)
        {
            chars[index] = Letters[RandomNumberGenerator.GetInt32(Letters.Length)];
        }

        return new string(chars);
    }

    private static string ExtensionFor(string contentType) => contentType.ToLowerInvariant() switch
    {
        "image/png" => ".png",
        "image/jpeg" or "image/jpg" => ".jpg",
        "image/webp" => ".webp",
        "image/gif" => ".gif",
        "image/bmp" => ".bmp",
        _ => ".jpg"
    };

    private async Task<int?> EnsureNamedId(string table, string column, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var normalized = value.Trim();
        var row = await Db.SingleAsync($"SELECT id FROM {table} WHERE LOWER({column}) = LOWER(@value) LIMIT 1", new { Value = normalized });
        if (row is not null)
        {
            return Convert.ToInt32(row["id"]);
        }

        return await Db.InsertAsync($"INSERT INTO {table} ({column}) VALUES (@value)", new { Value = normalized });
    }

    private async Task<List<int>> EnsureNamedIds(string table, string column, IEnumerable<string> values)
    {
        var ids = new List<int>();
        foreach (var value in values.Select(value => value.Trim()).Where(value => !string.IsNullOrWhiteSpace(value)).Distinct(StringComparer.OrdinalIgnoreCase))
        {
            var id = await EnsureNamedId(table, column, value);
            if (id is not null)
            {
                ids.Add(id.Value);
            }
        }

        return ids;
    }

    private async Task<int?> ExistingShelfIdOrNull(int? shelfId)
    {
        if (shelfId is null || shelfId <= 0)
        {
            return null;
        }

        var row = await Db.SingleAsync("SELECT id FROM polica WHERE id = @id", new { Id = shelfId.Value });
        return row is null ? null : shelfId.Value;
    }
    private async Task<List<int>> EnsureCategoryIds(IEnumerable<string> values)
    {
        var ids = new List<int>();
        foreach (var value in values.Select(value => value.Trim()).Where(value => !string.IsNullOrWhiteSpace(value)).Distinct(StringComparer.OrdinalIgnoreCase))
        {
            var row = await Db.SingleAsync("SELECT id FROM kategorija WHERE LOWER(naziv) = LOWER(@naziv) LIMIT 1", new { Naziv = value });
            if (row is not null)
            {
                ids.Add(Convert.ToInt32(row["id"]));
                continue;
            }

            var id = await Db.InsertAsync("INSERT INTO kategorija (naziv, opis) VALUES (@naziv, @opis)", new { Naziv = value, Opis = (string?)null });
            ids.Add(id);
        }

        return ids;
    }

    private async Task SyncImportRelations(int bookId, BookPayload payload)
    {
        await SyncRelation("kategorijaknjiga", "kategorija_id", bookId, payload.KategorijaIds);
        await SyncRelation("autorknjiga", "autor_id", bookId, payload.AutorIds);
        await SyncRelation("jezikknjiga", "jezik_id", bookId, payload.JezikIds);
        await SyncRelation("jezikoriginalknjiga", "jezik_original_id", bookId, payload.JezikOrigIds);
        await SyncRelation("pismoknjiga", "pismo_id", bookId, payload.PismoIds);
    }

    private async Task SyncRelation(string table, string idColumn, int bookId, IReadOnlyCollection<int>? ids)
    {
        if (ids is null)
        {
            return;
        }

        foreach (var id in ids.Where(id => id > 0).Distinct())
        {
            await Db.ExecuteAsync($"INSERT INTO {table} (knjiga_id, {idColumn}) VALUES (@book_id, @id)", new { BookId = bookId, Id = id });
        }
    }

    private void RemovePreview(int bookId)
    {
        _books.RemoveAll(book => book.Id == bookId);
        if (_pageIndex >= TotalPages)
        {
            _pageIndex = Math.Max(0, TotalPages - 1);
        }
    }

    private async Task<HashSet<int>> LoadExistingBookIds()
    {
        var rows = await Db.QueryAsync("SELECT knjiga_id FROM knjiga WHERE knjiga_id IS NOT NULL");
        return rows
            .Select(row => row["knjiga_id"])
            .Where(value => value is not null && value is not DBNull)
            .Select(value => Convert.ToInt32(value))
            .ToHashSet();
    }

    private string CoverUrl(AccessBookPreview book) =>
        string.IsNullOrWhiteSpace(_uploadId)
            ? "/images/book-placeholder.svg"
            : $"/access-uploads/{_uploadId}/book-cover/{book.Id}";

    private void ShowCover(AccessBookPreview book, MouseEventArgs args)
    {
        _hoveredBook = book;
        MoveCover(args);
    }

    private void MoveCover(MouseEventArgs args)
    {
        _coverX = args.ClientX;
        _coverY = args.ClientY;
        _coverOnLeft = args.ClientX > 900;
    }

    private void HideCover()
    {
        _hoveredBook = null;
    }

    private void PreviousPage()
    {
        if (_pageIndex > 0)
        {
            _pageIndex--;
        }
    }

    private void NextPage()
    {
        if (_pageIndex < TotalPages - 1)
        {
            _pageIndex++;
        }
    }

    private void HandlePagerKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "ArrowLeft")
        {
            PreviousPage();
        }
        else if (args.Key == "ArrowRight")
        {
            NextPage();
        }
    }


    private async Task ClearFile()
    {
        await JS.InvokeVoidAsync("libraryAccessUpload.release", _accessFileInput);
        _fileName = null;
        _activeAccessPath = null;
        ClearStoredUpload();
        _hasFile = false;
        _isLoading = false;
        _savingBookId = null;
        _bulkImporting = false;
        _bulkDone = 0;
        _bulkTotal = 0;
        _pageIndex = 0;
        _errorMessage = null;
        _books = [];
    }

    private void ClearStoredUpload()
    {
        AccessImportService.TryDelete(_uploadedTempPath);
        _uploadedTempPath = null;
        _uploadId = null;
    }

    private async Task LogBrowserError(string stage, Exception exception, string? details = null)
    {
        try
        {
            await JS.InvokeVoidAsync("libraryAccessUpload.logError", stage, exception.Message, new { details });
        }
        catch (JSDisconnectedException)
        {
            // Browser tab/circuit is already closed.
        }
    }
    private static int? FirstOrNull(IReadOnlyList<int> ids) => ids.Count == 0 ? null : ids[0];

    private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public void Dispose()
    {
        ClearStoredUpload();
    }
    private sealed record BrowserUploadFile(string Name, long Size);
    private sealed record CompletedBrowserUpload(string Id, string Path, string FileName, long Size);
}
