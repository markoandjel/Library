<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="lib/mudblazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="css/library.css" rel="stylesheet" />
    <style>
        html, body { min-height: 100%; margin: 0; background: #fff !important; color: #111827; font-family: Inter, Arial, sans-serif; }
        svg { width: 20px; height: 20px; }
        .mud-icon-root, .mud-button-icon-start svg { width: 20px !important; height: 20px !important; }
        .mud-layout { min-height: 100vh; width: 100%; }
        .app-menu-bar {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            width: calc(100% - 240px) !important;
            margin-left: 240px !important;
            height: 56px !important;
            min-height: 56px !important;
            background: #fff !important;
            color: #111827 !important;
            border-bottom: 1px solid #d8dde6;
            z-index: 1200 !important;
            box-shadow: 0 1px 3px rgba(15, 23, 42, .12) !important;
            display: flex !important;
            align-items: center !important;
        }
        .app-menu-bar .mud-toolbar { min-height: 56px !important; height: 56px !important; width: 100%; display: flex; justify-content: flex-start; align-items: center; padding-left: 28px; gap: 8px; }
        .app-menu-title { font-weight: 800; color: #0070cf; font-size: 20px; line-height: 1; margin: 0; }
        .app-nav-menu { padding: 12px; min-width: 240px; display: grid; gap: 4px; }
        .app-nav-menu .mud-nav-link,
        .app-nav-menu a {
            min-height: 48px;
            color: #111827 !important;
            font-size: 17px;
            font-weight: 700;
            display: flex !important;
            align-items: center;
