        }
        .app-nav-menu .mud-nav-link .mud-nav-link-content { display: flex; align-items: center; gap: 12px; }
        .app-nav-menu .mud-nav-link .mud-nav-link-text { font-size: 17px; font-weight: 700; }
        .app-nav-menu .mud-nav-link .mud-nav-link-icon, .app-nav-menu .mud-nav-link .mud-icon-root, .app-nav-menu a svg { color: #111827 !important; margin-top: 0 !important; flex: 0 0 auto; }
        .app-nav-menu .mud-nav-link.active, .app-nav-menu a.active { color: #0070cf !important; background: #e8f1ff; }
        .mobile-menu-button .mud-icon-root { color: #111827 !important; }
        .mobile-menu-button { display: none !important; }
        .mobile-menu-drawer { display: none; }
        .desktop-menu-drawer {
            display: block;
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            bottom: 0 !important;
            width: 240px !important;
            height: 100vh !important;
            background: #fff !important;
            border-right: 1px solid #d8dde6;
            z-index: 1250 !important;
            overflow-y: auto;
        }
        .mud-main-content {
            display: block !important;
            margin-left: 240px !important;
            padding-top: 56px !important;
            width: calc(100% - 240px) !important;
            min-height: 100vh;
            position: relative;
            z-index: 1;
            background: #fff;
            overflow: visible !important;
        }
        .desktop-menu-drawer + .mobile-menu-drawer + .mud-main-content { margin-left: 240px !important; }
        .library-shell { display: block !important; min-height: calc(100vh - 56px); padding: 8px 28px 24px !important; background: #fff; opacity: 1 !important; visibility: visible !important; }
        .filter-bar { min-height: 74px; border: 1px solid #d7dbe3; border-radius: 12px; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 14px 16px; box-shadow: 0 2px 5px rgba(15, 23, 42, .14); background: #fff; position: relative; z-index: 2; opacity: 1 !important; visibility: visible !important; }
        .library-state-panel { margin-top: 14px; border: 1px solid #d7dbe3; border-radius: 8px; padding: 18px 20px; background: #fff; }
        .library-state-progress { margin-bottom: 12px; }
        .library-state-text { color: #0070cf; font-weight: 800; }
        .filters { display: flex; align-items: center; flex-wrap: wrap; gap: 18px; min-width: 0; }
        .filter-label { color: #111827; font-weight: 500; }
        .id-input { width: 100px; }
        .filter-select { width: 192px; }
        .title-select { width: 260px; }
        .library-input { height: 40px; border: 1px solid #c6ceda; border-radius: 4px; background: #fff; color: #111827; padding: 0 14px; font-size: 14px; outline: none; }
        .library-input:focus { border-color: #2f80ed; box-shadow: 0 0 0 2px rgba(47,128,237,.14); }
        .combo-wrap { position: relative; }
        .author-combo { width: 192px; }
        .title-combo { width: 260px; }
        .combo-control { display: grid; grid-template-columns: minmax(0, 1fr) 42px; align-items: stretch; gap: 2px; height: 42px; }
        .combo-input { width: 100%; height: 42px; border-radius: 4px; box-sizing: border-box; align-self: stretch; }
        .combo-toggle { width: 42px; height: 42px; box-sizing: border-box; align-self: stretch; border: 1px solid #c6ceda; border-radius: 4px; background: #f8fafc; color: #111827; cursor: pointer; position: relative; }
        .combo-toggle::before { content: ""; position: absolute; left: 50%; top: 46%; width: 9px; height: 9px; border-right: 2px solid #111827; border-bottom: 2px solid #111827; transform: translate(-50%, -50%) rotate(45deg); }
        .combo-toggle:focus { border-color: #2f80ed; box-shadow: 0 0 0 2px rgba(47,128,237,.14); outline: none; }
        .search-dropdown { position: absolute; top: calc(100% + 1px); left: 0; width: 402px; z-index: 20; border: 1px solid #d9e0e8; border-radius: 6px; background: #f8fafc; box-shadow: 0 2px 8px rgba(15,23,42,.18); padding: 16px 16px 0; }
        .search-dropdown, .search-dropdown * { box-sizing: border-box; }
        .title-combo .search-dropdown { left: -42px; }
        .dropdown-search { display: block; margin-bottom: 10px; }
        .dropdown-search-input { height: 40px; border: 1px solid #c6ceda; border-radius: 4px; padding: 0 14px; font-size: 16px; color: #111827; outline: none; background: #fff; }
        .dropdown-search-input { width: 100%; }
        .dropdown-search-input:focus { border-color: #2f80ed; box-shadow: 0 0 0 1px #2f80ed; }
        .result-table { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid #d9e0e8; border-left: 1px solid #d9e0e8; background: #fff; }
        .result-head, .result-cell { min-width: 0; height: 25px; border-right: 1px solid #d9e0e8; border-bottom: 1px solid #d9e0e8; padding: 0 8px; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #222; font-size: 14px; line-height: 25px; }
        .result-head { background: #f8fafc; font-weight: 600; border-top: 0; border-left: 0; cursor: pointer; }
        .result-head:hover { background: #eef4fb; }
        .result-cell { border-top: 0; border-left: 0; background: #fff; cursor: pointer; }
        .result-cell:hover { background: #edf4ff; }
        .dropdown-pager { height: 40px; display: flex; align-items: center; justify-content: center; gap: 22px; color: #111827; }
        .dropdown-pager button { border: 0; background: transparent; color: #111827; font-size: 18px; line-height: 1; padding: 4px; cursor: pointer; }
        .dropdown-pager button:disabled { color: #d8dee8; cursor: default; }
        .dropdown-pager span { min-width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: #dbeafe; color: #4b647f; font-size: 14px; }
        .edit-actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex-wrap: wrap; }
        .edit-button, .save-button, .police-edit-button, .police-save-button { min-width: 148px; height: 42px; border-radius: 22px !important; font-weight: 700; color: #fff !important; box-shadow: 0 3px 7px rgba(25, 118, 210, .32); }
        .edit-button, .police-edit-button { background: #2f80ed !important; }
        .save-button, .police-save-button { background: #16a34a !important; box-shadow: 0 3px 7px rgba(22, 163, 74, .28); }
        .book-view { display: grid; grid-template-columns: minmax(600px, 1fr) minmax(420px, 592px); gap: 36px; padding-top: 14px; position: relative; z-index: 1; opacity: 1 !important; visibility: visible !important; }
        .book-view.read-view { grid-template-columns: minmax(560px, 820px) minmax(420px, 592px); gap: 22px; align-items: start; justify-content: center; }
        .book-view.edit-view { grid-template-columns: minmax(600px, 1fr) minmax(420px, 592px); gap: 36px; }
        .book-header { display: flex; align-items: center; gap: 14px; margin-bottom: 12px; }
        .book-id { width: 104px; height: 82px; border: 1px solid #d7dbe3; border-radius: 10px; display: grid; place-items: center; color: #0070cf; font-size: clamp(26px, 3vw, 34px); font-weight: 800; line-height: 1; background: #fff; padding: 0 8px; text-align: center; font-variant-numeric: tabular-nums; }
        .author-group { color: #0070cf; font-weight: 800; margin-bottom: 8px; }
        .book-title { color: #0070cf; font-weight: 800; line-height: 1.08; font-size: 32px; margin: 0; }
        .details-grid { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 4px 10px; max-width: 820px; margin-bottom: 16px; }
        .detail-label, .detail-value { color: #0070cf; font-size: 13px; line-height: 1.22; font-weight: 800; margin: 0; }
        .detail-value { overflow-wrap: anywhere; }
        .category-grid { display: grid; grid-template-columns: repeat(5, minmax(130px, 1fr)); gap: 3px 12px; max-width: 820px; }
        .category-check { display: inline-flex; align-items: center; gap: 8px; color: #0070cf; font-size: 13px; font-weight: 800; white-space: nowrap; min-width: 0; pointer-events: none; }
        .category-check input[type='checkbox'] { width: 18px; height: 18px; accent-color: #2f80ed; margin: 0; }
        .category-pills { display: flex; flex-wrap: wrap; gap: 8px; max-width: 820px; }
        .category-pill { min-height: 30px; border-radius: 999px; background: #e8f1ff; border: 1px solid #b9d6ff; color: #0070cf; display: inline-flex; align-items: center; padding: 4px 12px; font-size: 13px; font-weight: 800; line-height: 1.2; }
        .edit-header { align-items: flex-start; margin-bottom: 12px; }
        .edit-title-wrap { flex: 1; min-width: 0; }
        .edit-layout { display: grid; grid-template-columns: minmax(0, 520px) minmax(0, 560px); gap: 24px; align-items: start; }
        .edit-fields { display: grid; gap: 8px; }
        .edit-row { display: grid; grid-template-columns: 112px minmax(0, 1fr); align-items: center; gap: 8px; color: #111827; font-size: 16px; font-weight: 500; }
        .edit-row > span { color: #111827; }
        .edit-input { width: 100%; min-width: 0; height: 40px; border: 1px solid #c6ceda; border-radius: 4px; background: #fff; color: #111827; padding: 0 14px; font-size: 16px; outline: none; box-sizing: border-box; }
        .edit-input:focus { border-color: #2f80ed; box-shadow: 0 0 0 2px rgba(47,128,237,.14); }
        .edit-title-input { height: 64px; font-size: 30px; line-height: 1.1; }
        .edit-pairs { display: grid; grid-template-columns: repeat(2, minmax(220px, 1fr)); gap: 14px 18px; padding: 6px 0; }
        .edit-pairs .edit-row { grid-template-columns: minmax(118px, 1fr) 100px; }
        .edit-pairs .edit-row > span { white-space: nowrap; }
        .number-input { text-align: center; padding: 0 8px; }
        .number-input::-webkit-outer-spin-button, .number-input::-webkit-inner-spin-button { opacity: 1; display: block; margin-left: 4px; }
        .selector-row { align-items: start; }
        .item-selector { min-height: 48px; border: 1px solid #c6ceda; border-radius: 4px; background: #fff; display: grid; grid-template-columns: minmax(0, 1fr) minmax(130px, 160px); align-items: center; gap: 8px; padding: 6px; box-sizing: border-box; overflow: hidden; }
        .selected-items { display: flex; flex-wrap: wrap; gap: 6px; min-width: 0; }
        .selected-chip { height: 34px; border: 0; border-radius: 17px; background: #e7edf5; color: #111827; padding: 0 12px; font-size: 14px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
        .selected-chip span { font-size: 18px; line-height: 1; }
        .selector-select { min-width: 0; height: 34px; border: 0; border-left: 1px solid #e1e6ee; background: #fff; color: #667085; padding: 0 8px; font-size: 15px; outline: none; }
        .edit-textarea { min-height: 80px; resize: vertical; padding-top: 10px; line-height: 1.35; }
        .edit-note-row { align-items: start; }
        .edit-category-grid { grid-template-columns: repeat(3, minmax(150px, 1fr)); max-width: none; gap: 5px 16px; align-items: center; min-width: 0; }
        .edit-check { pointer-events: auto; }
        .edit-check.category-check { gap: 8px; font-size: 14px; line-height: 20px; min-height: 22px; }
        .edit-check.category-check input[type='checkbox'] { flex: 0 0 20px; width: 20px; height: 20px; box-sizing: border-box; }
        .media-side { padding-top: 0; min-width: 0; }
        .media-tabbar { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid #d8dde6; }
        .media-tab { height: 42px; border: 0; border-bottom: 3px solid transparent; background: #fff; display: flex; align-items: center; gap: 8px; padding-left: 14px; color: #111827; font-size: 15px; font-weight: 600; }
        .media-tab.active { color: #2f80ed; border-bottom-color: #2f80ed; }
        .tab-icon { width: 18px; height: 18px; border: 2px solid currentColor; border-radius: 2px; display: inline-block; position: relative; }
        .tab-icon::after { content: ""; position: absolute; left: 3px; right: 3px; bottom: 3px; height: 5px; background: currentColor; clip-path: polygon(0 100%, 38% 20%, 58% 62%, 78% 35%, 100% 100%); }
        .shelf-icon::after { clip-path: none; height: 2px; top: 7px; bottom: auto; }
        .image-card { margin-top: 16px; border: 1px solid #d7dbe3; border-radius: 12px; min-height: 466px; display: grid; place-items: center; padding: 16px; background: #fff; position: relative; overflow: hidden; }
        .image-loading { position: absolute; inset: 0; display: grid; place-items: center; background: #fff; z-index: 3; }
        .image-progress, .image-loading .mud-progress-circular { width: 64px !important; height: 64px !important; color: #2f80ed !important; }
        .image-progress svg, .image-loading .mud-progress-circular-svg { width: 64px !important; height: 64px !important; animation: shelf-progress-spin 1.2s linear infinite; }
        .image-loading .mud-progress-circular-circle { fill: none !important; stroke: #2f80ed !important; stroke-linecap: round; stroke-dasharray: 80 200 !important; stroke-dashoffset: 0; animation: shelf-progress-dash 1.2s ease-in-out infinite; }
        .book-cover-image { width: min(300px, 72%); max-height: 432px; object-fit: contain; display: block; opacity: 1; transition: opacity .18s ease; position: relative; z-index: 2; }
        .book-cover-image.loaded { opacity: 1; }
        .image-card:has(.book-cover-image) .image-loading { display: none; }
        .book-cover-placeholder { width: min(300px, 72%); aspect-ratio: 300 / 432; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding-top: 84px; color: #967247; background: linear-gradient(135deg, #321713 0%, #5a211b 52%, #21100f 100%); box-shadow: inset 0 0 42px rgba(0,0,0,.38); font-family: Georgia, serif; text-align: center; }
        .cover-small { font-size: 17px; letter-spacing: 2px; }
        .cover-large { font-size: 30px; letter-spacing: 5px; line-height: 1.25; }
        .cover-subtitle { margin-top: 12px; font-size: 12px; letter-spacing: 2px; }
        .cover-footer { margin-top: auto; margin-bottom: 78px; font-size: 18px; font-style: italic; color: #a47b4e; }
        .shelf-card { margin-top: 16px; min-height: 430px; border: 1px solid #d7dbe3; border-radius: 12px; padding: 18px 16px 22px; color: #111827; font-weight: 600; background: #f8f8f8; display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .shelf-map { width: min(420px, 100%); aspect-ratio: 300 / 225; position: relative; overflow: hidden; background: #e5e7eb; }
        .cabinet-ratio-map { width: min(var(--orman-display-width, 500px), 100%); aspect-ratio: var(--orman-ratio, 300 / 225); max-height: 400px; }
        .cabinet-image { width: 100%; height: 100%; object-fit: fill; display: block; opacity: 0; transition: opacity .16s ease; }
        .cabinet-image.loaded { opacity: 1; }
        .shelf-loading { position: absolute; inset: 0; display: grid; place-items: center; background: #f8f8f8; z-index: 5; }
        .shelf-progress, .shelf-loading .mud-progress-circular { width: 64px !important; height: 64px !important; color: #2f80ed !important; }
        .shelf-progress svg, .shelf-loading .mud-progress-circular-svg { width: 64px !important; height: 64px !important; animation: shelf-progress-spin 1.2s linear infinite; }
        .shelf-loading .mud-progress-circular-circle { fill: none !important; stroke: #2f80ed !important; stroke-linecap: round; stroke-dasharray: 80 200 !important; stroke-dashoffset: 0; animation: shelf-progress-dash 1.2s ease-in-out infinite; }
        @@keyframes shelf-progress-spin { to { transform: rotate(360deg); } }
        @@keyframes shelf-progress-dash {
            0% { stroke-dasharray: 1 200; stroke-dashoffset: 0; }
            50% { stroke-dasharray: 90 200; stroke-dashoffset: -35px; }
            100% { stroke-dasharray: 90 200; stroke-dashoffset: -125px; }
        }
        .shelf-marker { position: absolute; width: 38px; height: 24px; transform: translate(-50%, -50%); border-radius: 999px; border: 1px solid rgba(17,24,39,.18); background: #f8fafc; color: #111827; display: grid; place-items: center; font-size: 13px; font-weight: 800; box-shadow: 0 1px 2px rgba(15,23,42,.16); z-index: 2; }
        .shelf-marker.selected { background: #2f80ed; color: #fff; border-color: #0f5fc6; box-shadow: 0 0 0 3px rgba(47,128,237,.24), 0 2px 4px rgba(15,23,42,.25); }
        .cabinet-caption { margin-top: 16px; color: #111827; font-size: 16px; font-weight: 500; text-align: center; }
        .shelf-empty { color: #0070cf; font-weight: 800; }
        .demo-shell { min-height: 100vh; padding: 24px 28px !important; background: #fff; }
        .demo-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
        .demo-title { color: #0070cf; font-weight: 800 !important; }
        .demo-subtitle { color: #667085; font-size: 14px; margin-top: 4px; }
        .shelf-demo-grid, .cabinet-demo-grid { display: grid; grid-template-columns: repeat(3, minmax(220px, 1fr)); gap: 14px; margin-bottom: 18px; }
        .demo-card { border: 1px solid #d7dbe3; border-radius: 8px; padding: 14px; background: #fff; }
        .demo-card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .demo-card-title { color: #0070cf; font-weight: 800; font-size: 18px; }
        .demo-muted { color: #667085; font-size: 13px; margin-top: 4px; }
        .demo-status { border-radius: 999px; padding: 4px 10px; font-size: 12px; font-weight: 800; }
        .demo-status.full { background: #e8f1ff; color: #0070cf; }
        .demo-status.free { background: #dcfce7; color: #15803d; }
        .demo-metrics { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; color: #111827; font-size: 13px; }
        .demo-metrics span { border: 1px solid #d7dbe3; border-radius: 999px; padding: 4px 10px; background: #f8fafc; }
        .cabinet-demo-card { display: grid; grid-template-columns: 82px minmax(0, 1fr); gap: 14px; align-items: center; }
        .cabinet-thumb { width: 82px; height: 82px; border-radius: 8px; background: #e8f1ff; color: #0070cf; display: grid; place-items: center; font-size: 22px; font-weight: 900; }
        .cabinet-info { min-width: 0; }
        .demo-table-card { border: 1px solid #d7dbe3; border-radius: 8px; overflow: auto; }
        .demo-table { width: 100%; border-collapse: collapse; min-width: 620px; }
        .demo-table th, .demo-table td { border-bottom: 1px solid #e5e7eb; padding: 10px 12px; text-align: left; font-size: 14px; }
        .demo-table th { background: #f8fafc; color: #111827; font-weight: 800; }
        .demo-table td { color: #334155; }
        .police-shell { min-height: 100vh; padding: 24px 28px !important; background: #fff; }
        .police-layout { display: grid; grid-template-columns: minmax(280px, 40%) minmax(0, 60%); gap: 18px; align-items: stretch; }
        .police-side-card, .police-table-card, .police-empty { border: 1px solid #d7dbe3; border-radius: 10px; background: #fff; }
        .police-side-card { padding: 18px; height: 100%; }
        .police-side-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
        .police-eyebrow { color: #667085; font-size: 13px; font-weight: 700; text-transform: uppercase; }
        .police-title { color: #0070cf; font-weight: 800 !important; margin: 2px 0 18px; }
        .police-books-badge { min-width: 128px; height: 34px; border-radius: 999px; background: #e8f1ff; color: #0070cf; display: inline-grid; place-items: center; padding: 0 12px; font-size: 12px; font-weight: 900; white-space: nowrap; }
        .police-field { width: min(420px, 100%); display: grid; grid-template-columns: 72px minmax(0, 1fr); align-items: center; gap: 10px; margin: 0 auto 12px; color: #111827; font-weight: 600; }
        .police-select { width: 100%; }
        .police-selected-shelf { margin: 18px 0 14px; display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 12px; align-items: center; }
        .police-selected-shelf > span { width: 76px; height: 76px; border-radius: 10px; background: #e8f1ff; color: #0070cf; display: grid; place-items: center; font-size: 30px; font-weight: 900; }
        .police-card-label { color: #111827; font-weight: 800; }
        .police-card-meta { color: #667085; font-size: 14px; margin-top: 4px; }
        .police-map-card { display: flex; flex-direction: column; align-items: center; gap: 10px; margin-top: 16px; }
        .police-map { box-shadow: 0 1px 2px rgba(15,23,42,.08); }
        .police-marker { border: 0; font-family: inherit; cursor: pointer; }
        .police-marker:focus { outline: 3px solid rgba(47,128,237,.28); outline-offset: 2px; }
        .police-shelf-list { display: flex; flex-wrap: wrap; gap: 8px; }
        .police-shelf-chip { min-width: 42px; height: 34px; border-radius: 999px; border: 1px solid #c6ceda; background: #fff; color: #111827; font-weight: 800; cursor: pointer; }
