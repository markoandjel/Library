# Public HTTP endpoint: http://SERVER_IP:APP_PORT
APP_PORT=5098
APP_INTERNAL_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# MySQL (the database is not published on the host)
MYSQL_DATABASE=library
MYSQL_USER=library
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
MYSQL_PORT=3306

# SFTP image storage
SFTP_HOST=replace-with-sftp-host
SFTP_PORT=22
SFTP_USERNAME=replace-with-sftp-user
SFTP_PASSWORD=replace-with-sftp-password
SFTP_BASE_PATH=/data/Slike/
SFTP_CABINETS_PATH=/data/Ormani/
